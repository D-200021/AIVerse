{
  "name": "aiverse-office-backend",
  "version": "1.0.0",
  "description": "Express + MongoDB backend for AIVerse Inc. — stores chat/logs/agents and runs AI via Google Gemini (ES modules).",
  "main": "server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev1": "node --watch backend/server.js",
    "test": "node backend/test-routes.js",
    "dev:debug": "node --watch --inspect backend/server.js",
    "dev": "nodemon backend/server.js",
    "build": "npm install && npm install --prefix frontend && npm run build --prefix frontend"
  },
  "keywords": [],
